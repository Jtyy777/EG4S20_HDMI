# ============================================================================
# pin.adc  —— 数字标牌信息发布终端（info_signage）引脚约束
#
# 目标板：EG4S20 综合底板 + DMZ_EG4S20 口袋核心板
#   - HDMI / SD 卡：综合底板引脚
#   - 时钟 / 复位 / 矩阵键盘 / 拨码开关 / 数码管：核心板引脚
#
# 说明：两板核心芯片均为安路 EG4S20BG256（BGA256），纯逻辑互通；
#       此约束文件按目标底板引脚重写。
#
# 字段含义（每行都一样的三项，先说清楚再看下面就不会懵）：
#   LOCATION       芯片上的物理球号，必须与原理图一致，错了轻则不工作、
#                  重则两个信号抢同一个球；
#   IOSTANDARD     电平标准。LVCMOS33 = 3.3V 单端；LVDS33 = 3.3V 差分
#                  （HDMI 的 TMDS 用它）；
#   PULLTYPE       内部上下拉。输入按键靠 PULLUP 才能在没按时读到高电平；
#                  纯输出引脚一律 NONE，避免和外部驱动打架；
#   DRIVESTRENGTH  驱动能力（mA）。数码管和 SD 卡这类要拉电流的给 8，
#                  其余不写即用默认值。
#
# 改板卡时的顺序：先核对原理图球号，再核对电平标准，最后才看上下拉 ——
# 顺序反了会出现「引脚对了但电平不对」这种最难查的故障。
# ============================================================================

# ---- 时钟（核心板 50MHz 晶振） ----
set_pin_assignment { clk } { LOCATION = R7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# ---- 复位（核心板复位键 RSTn，低有效，接 E3） ----
set_pin_assignment { rst_n } { LOCATION = E3; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---- 4x4 矩阵键盘（核心板） ----
# Key_Col 为输入（读取），Key_Row 为输出（扫描）
# 列线必须上拉：不按下时靠上拉拉高，按下才被行线拉低，否则读到的全是
# 不定态。行线是推挽输出（同一时刻只有一根被拉低），不需要上拉。
set_pin_assignment { key_col[3] } { LOCATION = F10; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key_col[2] } { LOCATION = C11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key_col[1] } { LOCATION = D11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key_col[0] } { LOCATION = E11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key_row[3] } { LOCATION = D9;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { key_row[2] } { LOCATION = F9;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { key_row[1] } { LOCATION = C10; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { key_row[0] } { LOCATION = E10; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# ---- 拨码开关（核心板 SW[7:0]，可选扩展输入） ----
set_pin_assignment { sw_in[7] } { LOCATION = A14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sw_in[6] } { LOCATION = A13; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sw_in[5] } { LOCATION = B12; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sw_in[4] } { LOCATION = A12; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sw_in[3] } { LOCATION = A11; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sw_in[2] } { LOCATION = B10; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sw_in[1] } { LOCATION = A10; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sw_in[0] } { LOCATION = A9;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# ---- 4 位数码管（核心板，共阴） ----
# 段码 Digitron_Out[7:0]（高电平点亮）
set_pin_assignment { seg_data[0] } { LOCATION = A4; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { seg_data[1] } { LOCATION = A6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { seg_data[2] } { LOCATION = B8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { seg_data[3] } { LOCATION = E8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { seg_data[4] } { LOCATION = A7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { seg_data[5] } { LOCATION = B5; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { seg_data[6] } { LOCATION = A8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { seg_data[7] } { LOCATION = C8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
# 片选 DigitronCS[3:0]（低电平选中）
set_pin_assignment { seg_sel[0] } { LOCATION = C9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { seg_sel[1] } { LOCATION = B6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { seg_sel[2] } { LOCATION = A5; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { seg_sel[3] } { LOCATION = A3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# ---- HDMI TMDS 输出（综合底板，LVDS33） ----
# 四对差分线：CLK 一路 + D0/D1/D2 三路数据（TMDS 的通道 0/1/2）。
# 只写 _P 端即可 —— IOSTANDARD 设成 LVDS33 后，工具会把同一差分对的 _N
# 自动配对过去，代码里不需要、也不应该再单独声明 _N。
set_pin_assignment { HDMI_CLK_P } { LOCATION = P1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment { HDMI_D0_P }  { LOCATION = N1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment { HDMI_D1_P }  { LOCATION = P4; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment { HDMI_D2_P }  { LOCATION = J3; IOSTANDARD = LVDS33; PULLTYPE = NONE; }

# ---- SD 卡（综合底板，SPI 四线） ----
# ncs / mosi / dclk 是 FPGA 输出，给 8mA 驱动；miso 是输入。
# SPI 模式下时钟由 FPGA 产生，速率靠 sd_card_cmd 的 spi_clk_div 调，
# 与这里无关 —— 这里只决定电气特性，不决定通信速度。
set_pin_assignment { sd_ncs }  { LOCATION = F13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { sd_mosi } { LOCATION = F14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { sd_dclk } { LOCATION = F15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { sd_miso } { LOCATION = D14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
